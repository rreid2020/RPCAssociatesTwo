# Copy to .env and fill in. Used by: node server.js  (not Vite)
#
# Step-by-step (DO Spaces, CORS, deploy): see PORTAL_FILE_STORAGE_SETUP.md in this folder.
#
# ══ Database (standardized) ══
# Preferred: provide DATABASE_URL in api/server/.env as the single DB source.
# Example:
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
#
# SaaS scale (production): use your provider's connection POOLER URL, not direct Postgres.
# DigitalOcean example: pooled port often differs from direct (e.g. ...-pooler...:25061).
# Each API instance keeps a small pool; the pooler multiplexes many tenant requests.
#
# DATABASE_POOL_MAX=12          # per API instance (default 12 in production)
# DATABASE_POOL_MIN=2           # warm connections per instance (optional)
# API_INSTANCE_COUNT=3          # number of API replicas for startup capacity logging
# DATABASE_POOL_LOW_RESOURCE=true  # only for tiny dev DBs: force max=1
#
# Capacity planning: keep (DATABASE_POOL_MAX x API_INSTANCE_COUNT) within your DB/pooler limit.
#
# ══ Email (leads / contact) ══
# RESEND_API_KEY=re_...
# EMAIL_FROM=...
# NOTIFICATION_EMAIL=info@example.com
#
# ══ Client portal: Clerk (required in production) ══
# Get from https://dashboard.clerk.com — must match the frontend’s Clerk app.
# CLERK_SECRET_KEY=sk_test_... or sk_live_...
# PORTAL_APP_URL=https://axiomft.ca
#
# CORS: comma-separated list of site origins the browser will call this API from, e.g.
# ALLOWED_ORIGINS=https://axiomft.ca,https://www.axiomft.ca,https://portal.axiomft.ca,http://localhost:5173
#
# ══ File repository: DigitalOcean Spaces (S3-compatible) ══
# Without all four, POST /v1/files/presign-put returns 503 and the UI will show
# "object storage is not configured". Startup log also warns: [portal files] NOT configured
#
# Space endpoint (include https, no path). Example regions:
#   https://nyc3.digitaloceanspaces.com
#   https://sfo3.digitaloceanspaces.com
#   https://tor1.digitaloceanspaces.com
# DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# DO_SPACES_REGION=us-east-1
# S3 and AWS SDK want a region; any string often works for Spaces, us-east-1 is common
#
# DO_SPACES_BUCKET=your-bucket-name
# Create "Spaces key" in DO → API → Space keys (Access key + secret)
# DO_SPACES_KEY=... 
# DO_SPACES_SECRET=...
#
# (Aliases also supported: S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY, S3_SECRET_KEY, S3_REGION)
#
# ── CORS on the BUCKET (browser → direct PUT) ──
# The browser uploads to the presigned URL on your Space. In DigitalOcean: Space → CORS
# (or s3 CORS on the bucket), add something like (replace with your real origins):
#
# [
#   {
#     "AllowedOrigins": [
#       "https://axiomft.ca",
#       "https://www.axiomft.ca",
#       "https://portal.axiomft.ca",
#       "http://localhost:5173"
#     ],
#     "AllowedMethods": [ "GET", "PUT", "POST", "DELETE", "HEAD" ],
#     "AllowedHeaders": [ "Content-Type", "Authorization", "x-amz-acl" ],
#     "ExposeHeaders": [ "ETag" ],
#     "MaxAgeSeconds": 3000
#   }
# ]
#
# If CORS is wrong, upload fails after presign-put with a network / TypeError in the browser
# and the new UI shows a specific message + console.error.
#
# ══ TaxGPT (integrated chat + CRA RAG) ══
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.5
# OPENAI_EMBED_MODEL=text-embedding-3-small
#
# TaxGPT multi-model routing (optional — falls back to OPENAI_MODEL):
# GPT-5/o-series models require max_completion_tokens and do not accept custom temperature.
# TAXGPT_OPENAI_MODEL_FAST=gpt-5.4-mini        # simple factual CRA lookups
# TAXGPT_OPENAI_MODEL_STANDARD=gpt-5.5         # default RAG synthesis / longer answers
# TAXGPT_OPENAI_MODEL_COMPLEX=gpt-5.5-pro      # high-risk topics: GAAR, residency, avoidance
# TAXGPT_ASSUME_RETRIEVAL_READY=true          # keep TaxGPT usable during corpus ingest (default true)
#
# Populate CRA corpus (operator-only — SaaS owners, not tenant firms/workspaces):
# Run from CLI or internal ops tooling; do not expose in the client portal.
#   cd client-portal/taxgpt-api
#   npm run taxgpt:discover       # parse publications.html table (single seed)
#   npm run taxgpt:discover-folios # crawl technical-information folio index (S#-F#-C# chapters)
#   npm run taxgpt:expand         # resolve landing pages → HTML/PDF content URLs
#   npm run taxgpt:discover-all   # discover + expand in one run
#   npm run taxgpt:reconcile      # mark archived/cancelled pending rows as skipped
#   npm run taxgpt:audit          # corpus breakdown by status/category
#   npm run taxgpt:ingest         # chunk + embed active content sources
#   npm run taxgpt:stats
# Corpus HTTP tuning (CRA ingest from cloud often needs longer timeouts + slower RPS):
#   HTTP_TIMEOUT_MS=90000
#   HTTP_RETRIES=2
#   HTTP_RPS=0.75
#   PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium   # browser fallback for CRA ingest
#
#   npm run taxgpt:batch      # one expand + ingest batch (for DO scheduled jobs)
#   npm run taxgpt:pipeline   # loop until complete (long-running)
#
# Production (DigitalOcean): run expand/ingest as an App Platform Job, not on your laptop.
# See docs/taxgpt-corpus-digitalocean.md
#
# Live web search for TaxGPT federal/provincial legislation, case law, and planning strategies:
# TAVILY_API_KEY=tvly-...
# SERPER_API_KEY=...                 # optional fallback for strategy web search
#
# CanLII corpus ingest (optional — TaxGPT chat uses Tavily for live legislation/case law when TAVILY_API_KEY is set):
#   CANLII_API_KEY=              # from CanLII feedback form
#   CANLII_DISCOVER_LIMIT=50     # optional; cases discovered per batch
#
# ══ TaxGPT voluntary donations (Stripe) ══
# One-time donations to support TaxGPT development. Requires STRIPE_SECRET_KEY.
# STRIPE_SECRET_KEY=sk_test_...
# Preset amounts in cents (CAD), comma-separated:
# TAXGPT_DONATION_AMOUNTS_CENTS=1000,2500,5000,10000
# Optional Stripe Payment Link for custom amounts (opens in a new tab):
# TAXGPT_DONATION_URL=https://buy.stripe.com/...
#
# ══ Optional ══
# PORT=3000
# NODE_ENV=development
# PORTAL_STAFF_CLERK_IDS=user_xxx
# PORTAL_MAX_UPLOAD_BYTES=104857600
