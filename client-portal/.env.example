# Shared package migrations
# Keep this value identical to api/server DATABASE_URL.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Working Papers / Integrations feature flags
ENABLE_QBO_CONNECT=false
ENABLE_QBO_JOURNAL_POSTING=false
ENABLE_GOOGLE_SHEETS_CONNECT=false
ENABLE_AI_REVIEW=false

# Encryption key for token-at-rest encryption
ENCRYPTION_KEY=

# QuickBooks Online
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
QBO_ENVIRONMENT=sandbox
QBO_WEBHOOK_VERIFIER_TOKEN=

# Google Sheets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
