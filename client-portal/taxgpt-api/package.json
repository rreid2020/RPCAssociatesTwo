{
  "name": "@api/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "taxgpt:build-deps": "npm run build -w @rag/core",
    "pretaxgpt:stats": "npm run taxgpt:build-deps",
    "taxgpt:stats": "tsx src/scripts/taxgpt-corpus.ts stats",
    "pretaxgpt:audit": "npm run taxgpt:build-deps",
    "taxgpt:audit": "tsx src/scripts/taxgpt-corpus.ts audit",
    "pretaxgpt:discover": "npm run taxgpt:build-deps",
    "taxgpt:discover": "tsx src/scripts/taxgpt-corpus.ts discover",
    "pretaxgpt:discover-folios": "npm run taxgpt:build-deps",
    "taxgpt:discover-folios": "tsx src/scripts/taxgpt-corpus.ts discover-folios --limit=10",
    "pretaxgpt:expand": "npm run taxgpt:build-deps",
    "taxgpt:expand": "tsx src/scripts/taxgpt-corpus.ts expand --limit=50",
    "pretaxgpt:discover-all": "npm run taxgpt:build-deps",
    "taxgpt:discover-all": "tsx src/scripts/taxgpt-corpus.ts discover-all --limit=100",
    "pretaxgpt:reconcile": "npm run taxgpt:build-deps",
    "taxgpt:reconcile": "tsx src/scripts/taxgpt-corpus.ts reconcile",
    "pretaxgpt:discover-canlii": "npm run taxgpt:build-deps",
    "taxgpt:discover-canlii": "tsx src/scripts/taxgpt-corpus.ts discover-canlii --limit=50",
    "pretaxgpt:ingest": "npm run taxgpt:build-deps",
    "taxgpt:ingest": "tsx src/scripts/taxgpt-corpus.ts ingest --limit=10",
    "pretaxgpt:pipeline": "npm run taxgpt:build-deps",
    "taxgpt:pipeline": "tsx src/scripts/taxgpt-corpus.ts run-pipeline --expand-limit=10 --ingest-limit=10 --folio-limit=5",
    "pretaxgpt:run": "npm run taxgpt:build-deps",
    "taxgpt:run": "tsx src/scripts/taxgpt-corpus.ts run-pipeline --expand-limit=10 --ingest-limit=10 --folio-limit=5",
    "pretaxgpt:batch": "npm run taxgpt:build-deps",
    "taxgpt:batch": "tsx src/scripts/taxgpt-corpus.ts run-batch --expand-limit=5 --ingest-limit=5 --folio-limit=3"
  },
  "dependencies": {
    "@shared/types": "file:../packages/shared",
    "@rag/core": "file:../packages/rag",
    "@crawler/core": "file:../packages/crawler",
    "@storage/core": "file:../packages/storage",
    "@clerk/fastify": "^2.6.12",
    "drizzle-orm": "^0.29.1",
    "fastify": "^5.0.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.3.0",
    "dotenv": "^16.3.1",
    "openai": "^4.20.1",
    "pdf-parse": "^1.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.2"
  }
}

