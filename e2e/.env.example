# Copy values into a root .env file (Playwright loads it automatically).
# Use one dedicated Clerk test user assigned organization portal role "employee".
# Status must be active (not deactivated). Email must match Clerk exactly.
# The firm's workspace must already be onboarded by an owner/admin.

VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

E2E_EMPLOYEE_EMAIL=employee@example.com
E2E_EMPLOYEE_PASSWORD=your-test-password

# API server reads api/server/.env (DATABASE_URL, etc.) when Playwright starts it.

# Optional: override frontend URL when not using the Playwright webServer
# PLAYWRIGHT_BASE_URL=http://localhost:5173
