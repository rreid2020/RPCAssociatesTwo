{
  "name": "rpc-associates",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0 <21.0.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "npx tsc && vite build && npm run verify-build-chunks && npm run prerender",
    "verify-build-chunks": "node scripts/verify-build-chunks.mjs",
    "start": "npx serve -s dist -l 8080",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "seo:check": "node scripts/check-seo-governance.mjs",
    "arch:check": "node scripts/check-architecture-boundaries.mjs",
    "generate-sitemap": "node scripts/generate-sitemap.mjs",
    "generate-favicons": "node scripts/generate-favicons.mjs",
    "prerender": "node scripts/prerender-static-routes.mjs"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.60.0",
    "@portabletext/react": "^3.0.0",
    "@sanity/client": "^6.0.0",
    "@sanity/image-url": "^1.0.0",
    "@tanstack/react-query": "^5.100.14",
    "ag-grid-community": "^35.3.0",
    "ag-grid-react": "^35.3.0",
    "exceljs": "^4.4.0",
    "hyperformula": "^3.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.10.1",
    "serve": "^14.2.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@clerk/testing": "^2.0.35",
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.23",
    "dotenv": "^17.4.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.5.6",
    "puppeteer": "^25.1.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^2.1.9"
  }
}
